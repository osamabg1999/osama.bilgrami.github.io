---
import { site } from '../data/site';

const links = [
  { href: '#about', label: 'About' },
  { href: '#stack', label: 'Stack' },
  { href: '#masters-projects', label: "Master's" },
  { href: '#contact', label: 'Contact' },
] as const;

const base = import.meta.env.BASE_URL;
---

<header
  class="sticky top-0 z-50 border-b border-line/70 bg-ink/90 backdrop-blur-md supports-[backdrop-filter]:bg-ink/75"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a
      href={`${base}`}
      class="rounded px-1 font-mono text-sm font-medium tracking-tight text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-ink"
    >
      {site.name.split(' ').map((p) => p[0]).join('')}<span class="text-accent">.</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {
        links.map(({ href, label }) => (
          <a
            href={href}
            class="rounded px-1 text-sm text-muted transition-colors hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-1 md:flex" aria-label="Social">
      <a
        href={site.github}
        class="rounded p-2 text-muted transition-colors hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        aria-label="GitHub"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
          />
        </svg>
      </a>
      <a
        href={site.linkedin}
        class="rounded p-2 text-muted transition-colors hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        aria-label="LinkedIn"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          />
        </svg>
      </a>
    </div>

    <details class="relative md:hidden">
      <summary
        class="cursor-pointer list-none rounded-md border border-line bg-raised px-3 py-2 text-sm text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-accent [&::-webkit-details-marker]:hidden"
      >
        Menu
      </summary>
      <div
        class="absolute right-0 z-50 mt-2 w-52 rounded-lg border border-line bg-panel p-2 shadow-xl"
        role="navigation"
        aria-label="Mobile"
      >
        {
          links.map(({ href, label }) => (
            <a
              href={href}
              class="block rounded-md px-3 py-2 text-sm text-muted hover:bg-raised hover:text-white"
            >
              {label}
            </a>
          ))
        }
        <div class="mt-2 flex gap-2 border-t border-line pt-2">
          <a
            href={site.github}
            class="flex-1 rounded-md border border-line py-2 text-center text-xs text-muted hover:text-white"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
          <a
            href={site.linkedin}
            class="flex-1 rounded-md border border-line py-2 text-center text-xs text-muted hover:text-white"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </a>
        </div>
      </div>
    </details>
  </div>
</header>
