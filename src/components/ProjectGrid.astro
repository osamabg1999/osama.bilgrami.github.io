---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
---

<section
  id="masters-projects"
  class="mx-auto max-w-5xl scroll-mt-24 px-4 py-16 sm:px-6 sm:py-20"
  aria-labelledby="masters-heading"
>
  <h2
    id="masters-heading"
    class="font-mono text-sm font-medium uppercase tracking-widest text-accent"
  >
    Master&apos;s projects
  </h2>
  <p class="mt-3 max-w-2xl text-muted">
    Coursework and research from my Master's in Data Science &amp; Analytics at the University of Calgary: repositories and a
    Tableau gallery linked below.
  </p>
  <div class="mt-12 grid gap-8 lg:grid-cols-2">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>
